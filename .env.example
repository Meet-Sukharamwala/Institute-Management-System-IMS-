# Institute Management System (IMS) Environment Configuration
# Copy to .env for local or production deployment. Never commit real secrets.

NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Database configuration
# Embedded SQLite path for standalone / sandbox mode, or MySQL connection URL for external cluster
DATABASE_PATH="./data/ims.sqlite"
DATABASE_URL="mysql://ims_user:CHANGE_ME_PASSWORD@localhost:3306/ims_production"

# Authentication & Session Security
SESSION_SECRET="replace-with-64-byte-cryptographic-random-hex-secret"
SESSION_TTL_HOURS="12"
CSRF_COOKIE_SECURE="false"

# Initial Production Bootstrap (used only by scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_EMAIL="admin@institute.edu.in"

# Notification Channel Providers (Leave empty to run in transparent Development Sandbox Mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""
